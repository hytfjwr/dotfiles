[core]
    editor = nvim

[init]
    defaultBranch = main

[pull]
    rebase = false

[status]
    showuntrackedfiles = yes

[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

# Identity and per-directory overrides live in ~/.gitconfig.local
# (git/.gitconfig.local in this repo, not tracked). Included last so it wins.
[include]
    path = ~/.gitconfig.local
