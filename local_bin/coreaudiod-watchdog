#!/bin/bash
# coreaudiod-watchdog - Restart coreaudiod when it runs away, keeping evidence
#
# Run every 30 seconds by launchd (launchd/com.hytfjwr.coreaudiod-watchdog.plist).
# Under heavy CPU load, coreaudiod can fall into a loop of
# "Audio IO Overload: client timeout" and stay at 150%+ CPU until restarted.
# When its CPU stays above the threshold for several runs in a row, this saves
# what was going on (audio clients, load, coreaudiod log) and then restarts it.
#
# The restart needs a sudoers rule (once, by hand):
#   echo "$(whoami) ALL=(root) NOPASSWD: /usr/bin/killall coreaudiod" \
#     | sudo tee /etc/sudoers.d/coreaudiod-watchdog >/dev/null
#   sudo chmod 440 /etc/sudoers.d/coreaudiod-watchdog
#   sudo visudo -cf /etc/sudoers.d/coreaudiod-watchdog
# Without it, the evidence is still saved and a notification asks for a manual restart.

# No pipefail: the evidence pipelines end in head/grep, which may cut ps short
# or match nothing, and neither should stop the restart.
set -eu

CPU_THRESHOLD="${CPU_THRESHOLD:-80}"  # percent (ps %cpu)
STREAK_NEEDED="${STREAK_NEEDED:-4}"   # consecutive runs over the threshold (4 x 30s = 2 min)
COOLDOWN_SEC=600                      # no second restart within this window
KEEP_EVIDENCE=30                      # evidence directories to keep
DRY_RUN="${DRY_RUN:-0}"               # 1: save evidence but do not restart or notify

STATE_DIR="${STATE_DIR:-$HOME/.local/state/coreaudiod-watchdog}"
STREAK_FILE="$STATE_DIR/streak"
LAST_RESTART_FILE="$STATE_DIR/last-restart"
mkdir -p "$STATE_DIR"
exec >> "$STATE_DIR/watchdog.log" 2>&1

now="$(date +%s)"
pid="$(/usr/bin/pgrep -x coreaudiod || true)"
[[ -z "$pid" ]] && exit 0
cpu="$(/bin/ps -o %cpu= -p "$pid" | tr -d ' ')"
cpu_int="${cpu%.*}"

streak="$(cat "$STREAK_FILE" 2>/dev/null || echo 0)"
if (( cpu_int >= CPU_THRESHOLD )); then
    streak=$((streak + 1))
else
    streak=0
fi
echo "$streak" > "$STREAK_FILE"
(( streak < STREAK_NEEDED )) && exit 0

last="$(cat "$LAST_RESTART_FILE" 2>/dev/null || echo 0)"
if (( now - last < COOLDOWN_SEC )); then
    echo "$(date '+%F %T') cpu=$cpu streak=$streak (cooldown, skip)"
    exit 0
fi

# --- evidence -------------------------------------------------------------
ev="$STATE_DIR/evidence/$(date '+%Y%m%d-%H%M%S')"
mkdir -p "$ev"
{
    echo "coreaudiod pid=$pid cpu=$cpu streak=$streak"
    /bin/ps -o pid,etime,time,%cpu -p "$pid"
    /usr/bin/uptime
} > "$ev/summary.txt"

/bin/ps -Ao pid,ppid,etime,%cpu,rss,command -r | head -40 | cut -c1-300 > "$ev/top-cpu.txt"

# Audio-out contexts and whether the process that created each one is still alive.
# Many dead creators means coreaudiod is holding IO for clients that are gone.
/usr/bin/pmset -g assertions > "$ev/pmset-assertions.txt" 2>&1 || true
{
    printf 'pid\talive\tppid\tcommand\tparent\n'
    grep -Eo 'Created for PID: [0-9]+' "$ev/pmset-assertions.txt" | grep -Eo '[0-9]+' | sort -un |
        while read -r p; do
            if info="$(/bin/ps -o ppid=,command= -p "$p" 2>/dev/null)"; then
                ppid="$(awk '{print $1}' <<<"$info")"
                cmd="$(cut -c1-200 <<<"${info#*[0-9] }")"
                parent="$(/bin/ps -o command= -p "$ppid" 2>/dev/null | cut -c1-200 || true)"
                printf '%s\tyes\t%s\t%s\t%s\n' "$p" "$ppid" "$cmd" "$parent"
            else
                printf '%s\tno\t\t\t\n' "$p"
            fi
        done
} > "$ev/audio-clients.tsv"

# Processes that typically produce sound, with their parents.
/bin/ps -Ao pid,ppid,etime,command | grep -E '[a]fplay|[s]ay |[A]udioComponentRegistrar' | cut -c1-300 > "$ev/sound-procs.txt" || true

# Last 2 minutes of coreaudiod's log: per-minute overload counts and the client pids it names.
/usr/bin/log show --last 2m --predicate 'process == "coreaudiod"' --style compact > "$ev/coreaudiod.log" 2>&1 || true
{
    echo "## overloads per minute"
    grep 'Overload possibly' "$ev/coreaudiod.log" | grep -Eo '^[0-9-]+ [0-9]{2}:[0-9]{2}' | uniq -c || true
    echo "## client pids named in the log"
    grep -Eo 'pid: [0-9]+' "$ev/coreaudiod.log" | sort | uniq -c | sort -rn | head -20 || true
} > "$ev/coreaudiod-summary.txt"

# --- restart ----------------------------------------------------------------
if [[ "$DRY_RUN" == 1 ]]; then
    echo "$(date '+%F %T') cpu=$cpu streak=$streak dry-run evidence=$ev"
    exit 0
fi
if /usr/bin/sudo -n /usr/bin/killall coreaudiod 2>"$ev/restart-error.txt"; then
    rm -f "$ev/restart-error.txt"
    echo "$now" > "$LAST_RESTART_FILE"
    echo 0 > "$STREAK_FILE"
    result="restarted"
    msg="CPU ${cpu}% が続いたため再起動しました"
else
    result="restart-failed"
    msg="CPU ${cpu}% が続いています。sudoers 未設定のため手動で再起動してください"
fi
echo "$(date '+%F %T') cpu=$cpu streak=$streak $result evidence=$ev"
/usr/bin/osascript -e "display notification \"$msg\" with title \"coreaudiod-watchdog\"" || true

# Keep only the newest evidence directories.
ls -1dt "$STATE_DIR"/evidence/*/ 2>/dev/null | tail -n +$((KEEP_EVIDENCE + 1)) | while read -r old; do rm -rf "$old"; done
